{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent_allish/intake/communication_context.schema.json",
  "title": "Provisional communication input (requires agreement with communication module owner)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "const": "communication_context"
    },
    "schema_version": {
      "const": "0.1-draft"
    },
    "contract_status": {
      "const": "proposed_not_approved"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "brief_revision": {
      "type": "integer",
      "minimum": 1
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delivery_model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "description",
        "stage",
        "capabilities",
        "delivery_model"
      ]
    },
    "customer_need": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "problem": {
          "type": [
            "string",
            "null"
          ]
        },
        "desired_outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "problem",
        "desired_outcome",
        "current_alternatives"
      ]
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "buyer": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_user": {
          "type": [
            "string",
            "null"
          ]
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "buyer",
        "end_user",
        "segments"
      ]
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geography": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "industry": {
          "type": [
            "string",
            "null"
          ]
        },
        "competitors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "geography",
        "industry",
        "competitors"
      ]
    },
    "communications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positioning": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_messages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current_channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "brand_materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "positioning",
        "current_messages",
        "current_channels",
        "brand_materials"
      ]
    },
    "goals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason_for_request": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_horizon": {
          "type": [
            "string",
            "null"
          ]
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "reason_for_request",
        "target_horizon",
        "success_criteria"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "available_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "material_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "url",
              "note",
              "other"
            ]
          },
          "access_status": {
            "type": "string",
            "enum": [
              "available",
              "not_provided",
              "needs_permission",
              "unknown"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "material_id",
          "title",
          "uri",
          "kind",
          "access_status",
          "notes"
        ]
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field_path": {
            "type": "string",
            "pattern": "^/"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "enum": [
              "unknown",
              "not_applicable",
              "not_provided",
              "conflicting"
            ]
          },
          "owner": {
            "type": "string",
            "enum": [
              "user",
              "research",
              "unknown"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "normal",
              "low"
            ]
          }
        },
        "required": [
          "field_path",
          "description",
          "reason",
          "owner",
          "priority"
        ]
      }
    },
    "field_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field_path": {
            "type": "string",
            "pattern": "^/"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "user_reported",
              "user_document",
              "agent_hypothesis"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim_status": {
            "type": "string",
            "enum": [
              "reported_fact",
              "reported_hypothesis",
              "document_supported",
              "agent_hypothesis"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "field_path",
          "source_type",
          "source_ref",
          "claim_status",
          "notes"
        ]
      }
    },
    "product_strategy_output_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "document_type",
    "schema_version",
    "contract_status",
    "case_id",
    "brief_revision",
    "product",
    "customer_need",
    "audience",
    "market",
    "communications",
    "goals",
    "constraints",
    "available_materials",
    "unknowns",
    "field_provenance",
    "product_strategy_output_ref"
  ]
}
