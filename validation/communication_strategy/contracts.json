{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Communication Strategy Module v0.1",
  "$defs": {
    "module_request": {
      "type": "object",
      "required": [
        "document_type",
        "module_id",
        "protocol_version",
        "request_id",
        "case_id",
        "action"
      ],
      "properties": {
        "document_type": {
          "const": "module_request"
        },
        "module_id": {
          "const": "communication_strategy"
        },
        "protocol_version": {
          "const": "0.1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "start_case",
            "run_next_stage",
            "approve_stage",
            "attach_human_data",
            "update_brief",
            "get_status",
            "get_strategy"
          ]
        },
        "confirmed_brief": {
          "$ref": "#/$defs/confirmed_brief"
        },
        "product_strategy_outline": {
          "type": [
            "object",
            "null"
          ]
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "stage_id": {
          "type": "string"
        },
        "parent_approval": {
          "type": "boolean"
        },
        "data_artifacts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "start_case"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "confirmed_brief",
              "product_strategy_outline"
            ]
          }
        }
      ]
    },
    "module_response": {
      "type": "object",
      "required": [
        "document_type",
        "module_id",
        "protocol_version",
        "case_id",
        "status",
        "artifacts",
        "next_action"
      ],
      "properties": {
        "document_type": {
          "const": "module_response"
        },
        "module_id": {
          "const": "communication_strategy"
        },
        "protocol_version": {
          "const": "0.1"
        },
        "case_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "awaiting_parent",
            "needs_human_data",
            "blocked",
            "done"
          ]
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "saved"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "saved": {
                "type": "boolean"
              },
              "content": {}
            },
            "additionalProperties": true
          }
        },
        "data_requests": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "product_gap_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "strategy": {
      "type": "object",
      "required": [
        "audience_and_situation",
        "communication_barrier",
        "desired_change",
        "alternatives",
        "positioning",
        "messages_and_proofs",
        "channel_roles",
        "action_plan",
        "validation_plan",
        "evidence_limitations"
      ],
      "properties": {
        "audience_and_situation": {
          "type": "string"
        },
        "communication_barrier": {
          "type": "string"
        },
        "desired_change": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object"
          }
        },
        "positioning": {
          "type": "string"
        },
        "messages_and_proofs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "channel_roles": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "action_plan": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "validation_plan": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "evidence_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "product_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "confirmed_brief": {
      "$comment": "Input is the original common_intake brief.json. This is an envelope/invariant check; first validate the full value against validation/common_intake/brief.schema.json (Draft 2020-12). Request case_id must match confirmed_brief.case_id (runtime check).",
      "type": "object",
      "required": [
        "schema_version",
        "case_id",
        "revision",
        "interview_status",
        "decision_question",
        "product",
        "customer_need",
        "audience",
        "market",
        "commercial",
        "communications",
        "goals",
        "constraints",
        "available_materials",
        "unknowns",
        "contradictions",
        "field_provenance",
        "user_confirmed_brief",
        "source_class",
        "confirmed_at",
        "confirmation_summary"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "interview_status": {
          "const": "confirmed"
        },
        "decision_question": {
          "type": "string",
          "minLength": 1
        },
        "user_confirmed_brief": {
          "const": true
        },
        "confirmed_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "confirmation_summary": {
          "type": "string",
          "minLength": 1
        },
        "source_class": {
          "const": "user_reported"
        },
        "field_provenance": {
          "type": "array"
        },
        "unknowns": {
          "type": "array"
        },
        "contradictions": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  }
}
