{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Communication Strategy Module v0.1",
  "$defs": {
    "module_request": {
      "type": "object",
      "properties": {
        "document_type": {
          "const": "module_request"
        },
        "module_id": {
          "const": "communication_strategy"
        },
        "protocol_version": {
          "const": "0.1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "action": {
          "enum": [
            "start_case",
            "run_next_stage",
            "approve_stage",
            "attach_human_data",
            "update_brief",
            "get_status",
            "get_strategy"
          ]
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed_brief": {
          "$ref": "#/$defs/confirmed_brief"
        },
        "product_strategy_outline": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/product_outline"
            }
          ]
        },
        "updated_brief": {
          "$ref": "#/$defs/confirmed_brief"
        },
        "stage_id": {
          "type": "string",
          "enum": [
            "C01",
            "C02",
            "C03",
            "C04",
            "C05",
            "C06"
          ]
        },
        "parent_approval": {
          "type": "boolean"
        },
        "method_id": {
          "type": "string",
          "pattern": "^M(0[1-9]|1[0-2])$"
        },
        "data_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "file",
                  "url",
                  "note",
                  "other"
                ]
              },
              "source_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "consent_or_permission": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "kind"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "parent_notes": {
          "type": "string"
        }
      },
      "required": [
        "document_type",
        "module_id",
        "protocol_version",
        "request_id",
        "case_id",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "start_case"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "confirmed_brief",
              "product_strategy_outline",
              "expected_revision"
            ],
            "properties": {
              "expected_revision": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "run_next_stage"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "expected_revision"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "approve_stage"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "expected_revision"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "attach_human_data"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "expected_revision"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "update_brief"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "expected_revision"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "approve_stage"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "stage_id",
              "parent_approval"
            ],
            "properties": {
              "parent_approval": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "attach_human_data"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "method_id",
              "data_artifacts"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "update_brief"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "updated_brief"
            ]
          }
        }
      ]
    },
    "module_response": {
      "type": "object",
      "properties": {
        "document_type": {
          "const": "module_response"
        },
        "module_id": {
          "const": "communication_strategy"
        },
        "protocol_version": {
          "const": "0.1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "action": {
          "enum": [
            "start_case",
            "run_next_stage",
            "approve_stage",
            "attach_human_data",
            "update_brief",
            "get_status",
            "get_strategy"
          ]
        },
        "status": {
          "enum": [
            "accepted",
            "awaiting_parent",
            "needs_human_data",
            "blocked",
            "done"
          ]
        },
        "state_revision": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string"
        },
        "stage_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "enum": [
                "C01",
                "C02",
                "C03",
                "C04",
                "C05",
                "C06"
              ]
            }
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "data_requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data_request"
          }
        },
        "product_gap_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0
          }
        },
        "next_action": {
          "enum": [
            "run_next_stage",
            "approve_stage",
            "attach_human_data",
            "get_status",
            "get_strategy",
            "await_parent",
            "none"
          ]
        },
        "persistence_status": {
          "enum": [
            "saved",
            "delegated_or_unavailable"
          ]
        },
        "awaiting_parent_confirmation": {
          "type": "boolean"
        }
      },
      "required": [
        "document_type",
        "module_id",
        "protocol_version",
        "request_id",
        "case_id",
        "action",
        "status",
        "state_revision",
        "artifacts",
        "data_requests",
        "product_gap_flags",
        "limitations",
        "errors",
        "next_action",
        "persistence_status",
        "awaiting_parent_confirmation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "errors": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "awaiting_parent"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "stage_id"
            ],
            "properties": {
              "awaiting_parent_confirmation": {
                "const": true
              },
              "stage_id": {
                "$ref": "#/$defs/stage_id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "persistence_status": {
                "const": "saved"
              }
            },
            "required": [
              "persistence_status"
            ]
          },
          "then": {
            "properties": {
              "artifacts": {
                "type": "array",
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/artifact_ref"
                    },
                    {
                      "properties": {
                        "saved": {
                          "const": true
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "needs_human_data"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "data_requests": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "strategy": {
      "type": "object",
      "properties": {
        "document_type": {
          "const": "communication_strategy_draft"
        },
        "module_id": {
          "const": "communication_strategy"
        },
        "protocol_version": {
          "const": "0.1"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "status": {
          "const": "draft"
        },
        "source_brief_revision": {
          "type": "integer",
          "minimum": 1
        },
        "stage_result_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^cases/[A-Za-z0-9_-]+/communication_strategy/"
          },
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true
        },
        "audience_and_situation": {
          "type": "string"
        },
        "communication_barrier": {
          "type": "string"
        },
        "desired_change": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "alternative_type": {
                "enum": [
                  "status_quo",
                  "develop",
                  "other",
                  "exit"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence_ref"
                }
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 0
                }
              }
            },
            "required": [
              "alternative_type",
              "description"
            ],
            "additionalProperties": true
          },
          "minItems": 3,
          "contains": {
            "type": "object",
            "required": [
              "alternative_type"
            ],
            "properties": {
              "alternative_type": {
                "const": "status_quo"
              }
            }
          }
        },
        "positioning": {
          "type": "string"
        },
        "messages_and_proofs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "channel_roles": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "action_plan": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "validation_plan": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "evidence_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "product_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "document_type",
        "module_id",
        "protocol_version",
        "case_id",
        "status",
        "source_brief_revision",
        "stage_result_refs",
        "audience_and_situation",
        "communication_barrier",
        "desired_change",
        "alternatives",
        "positioning",
        "messages_and_proofs",
        "channel_roles",
        "action_plan",
        "validation_plan",
        "evidence_limitations"
      ],
      "additionalProperties": false,
      "$comment": "Strategy is a draft even with completed C01–C06; status is not market validation. The native method YAMLs have separate dynamic required fields."
    },
    "confirmed_brief": {
      "$comment": "Input is the original common_intake brief.json. This is an envelope/invariant check; first validate the full value against validation/common_intake/brief.schema.json (Draft 2020-12). Request case_id must match confirmed_brief.case_id (runtime check).",
      "type": "object",
      "required": [
        "schema_version",
        "case_id",
        "revision",
        "interview_status",
        "decision_question",
        "product",
        "customer_need",
        "audience",
        "market",
        "commercial",
        "communications",
        "goals",
        "constraints",
        "available_materials",
        "unknowns",
        "contradictions",
        "field_provenance",
        "user_confirmed_brief",
        "source_class",
        "confirmed_at",
        "confirmation_summary"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "interview_status": {
          "const": "confirmed"
        },
        "decision_question": {
          "type": "string",
          "minLength": 1
        },
        "user_confirmed_brief": {
          "const": true
        },
        "confirmed_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "confirmation_summary": {
          "type": "string",
          "minLength": 1
        },
        "source_class": {
          "const": "user_reported"
        },
        "field_provenance": {
          "type": "array"
        },
        "unknowns": {
          "type": "array"
        },
        "contradictions": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "product_outline": {
      "$comment": "This envelope guards against arbitrary objects. Validate the full product strategy outline separately against validation/product_strategy/contracts.json#/$defs/strategy_outline; verify case_id identity and source access in the executor.",
      "type": "object",
      "required": [
        "document_type",
        "protocol_version",
        "case_id",
        "status",
        "stage_result_refs",
        "alternatives",
        "limitations"
      ],
      "properties": {
        "document_type": {
          "const": "strategy_outline"
        },
        "protocol_version": {
          "const": "0.2"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "status": {
          "const": "draft"
        },
        "stage_result_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 3
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0
          }
        }
      },
      "additionalProperties": true
    },
    "artifact_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^cases/[A-Za-z0-9_-]+/communication_strategy/"
        },
        "kind": {
          "enum": [
            "brief",
            "state",
            "method_result",
            "stage_result",
            "strategy",
            "human_input",
            "history",
            "other"
          ]
        },
        "saved": {
          "type": "boolean"
        },
        "content": {},
        "content_sha256": {
          "type": "string",
          "minLength": 1
        },
        "sensitivity": {
          "enum": [
            "public",
            "restricted",
            "sensitive"
          ]
        }
      },
      "required": [
        "path",
        "kind",
        "saved"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "saved": {
                "const": false
              }
            },
            "required": [
              "saved"
            ]
          },
          "then": {
            "required": [
              "content"
            ]
          }
        }
      ]
    },
    "evidence_ref": {
      "type": "object",
      "properties": {
        "source_type": {
          "enum": [
            "user_reported",
            "user_document",
            "public_source",
            "model_calculation",
            "hypothesis",
            "synthetic_example"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "claim_status": {
          "enum": [
            "observed",
            "document_supported",
            "reported_fact",
            "reported_hypothesis",
            "inferred",
            "hypothesis",
            "unverified"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "source_type",
        "source_ref"
      ],
      "additionalProperties": false
    },
    "data_request": {
      "type": "object",
      "properties": {
        "method_id": {
          "type": "string",
          "pattern": "^M(0[1-9]|1[0-2])$"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "required_data": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "collection_instructions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "recommended_format": {
          "type": "string"
        },
        "consent_or_permission_needed": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "open",
            "fulfilled",
            "withdrawn"
          ]
        }
      },
      "required": [
        "method_id",
        "request_id",
        "purpose",
        "required_data",
        "collection_instructions",
        "status"
      ],
      "additionalProperties": false
    },
    "method_record": {
      "type": "object",
      "properties": {
        "document_type": {
          "const": "method_record"
        },
        "module_id": {
          "const": "communication_strategy"
        },
        "protocol_version": {
          "const": "0.1"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "method_id": {
          "type": "string",
          "pattern": "^M(0[1-9]|1[0-2])$"
        },
        "home_stage": {
          "type": "string",
          "enum": [
            "C01",
            "C02",
            "C03",
            "C04",
            "C05",
            "C06"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "in_progress",
            "awaiting_data",
            "partial",
            "completed",
            "not_applicable",
            "needs_review"
          ]
        },
        "native_result": {
          "type": [
            "object",
            "null"
          ]
        },
        "selected_because": {
          "type": "string",
          "minLength": 1
        },
        "method_file": {
          "type": "string",
          "pattern": "^validation/communication_strategy/methods/M(0[1-9]|1[0-2])\\.yaml$"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0
          }
        },
        "data_requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data_request"
          }
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "previous_version_ref": {
          "type": "string",
          "pattern": "^cases/[A-Za-z0-9_-]+/communication_strategy/"
        }
      },
      "required": [
        "document_type",
        "module_id",
        "protocol_version",
        "case_id",
        "method_id",
        "home_stage",
        "status",
        "native_result",
        "selected_because",
        "method_file",
        "evidence_refs",
        "assumptions",
        "limitations",
        "data_requests",
        "version"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "native_result": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "awaiting_data"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "data_requests": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "stage_record": {
      "type": "object",
      "properties": {
        "document_type": {
          "const": "stage_record"
        },
        "module_id": {
          "const": "communication_strategy"
        },
        "protocol_version": {
          "const": "0.1"
        },
        "case_id": {
          "type": "string",
